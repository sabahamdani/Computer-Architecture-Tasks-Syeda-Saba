
1 global _main
2 extern _printf
3
4 section . data
5 msg db " Original : % d | SHR 1 (/2) : % d | SHR 2 (/4) : % d " , 10 , 0
6
7 section . text
8 _main :
9 mov eax , 64 ; Base value
10 mov ebx , eax
11 shr ebx , 1 ; Shift right 1 bit = 64 / 2 = 32
12
13 mov ecx , eax
14 shr ecx , 2 ; Shift right 2 bits = 64 / 4 = 16
15
16 push ecx
17 push ebx
18 push eax
19 push msg
20 call _printf
21 add esp , 16
22
23 xor eax , eax
24 ret