
global _main
extern _printf
section .data
format db "Value in AL = %d", 10, 0
section .text
_main;
mov al, 10
; printf works with larger values.
; MOVZX copies AL into EAX and fills
; the remaining bits with zeros.
movzx eax, a
push eax

call _printf
add esp, 8
; Return 0 from the program.
xor eax, eax
ret